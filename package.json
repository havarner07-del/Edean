{
  "name": "edean",
  "version": "0.1.0",
  "description": "Edean — a private, self-hosted chat app for a coding-focused LLM.",
  "private": true,
  "type": "module",
  "main": "launcher.js",
  "scripts": {
    "start": "node launcher.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "build:exe": "node scripts/build-exe.mjs",
    "serve": "node server.js",
    "build:exe:win": "node scripts/build-exe.mjs --target=win-x64"
  },
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "@highlightjs/cdn-assets": "^11.11.1",
    "dompurify": "^3.4.16",
    "marked": "^18.0.14",
    "monaco-editor": "^0.57.0"
  },
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.28.2",
    "postject": "^1.0.0-alpha.6",
    "resedit": "^3.1.0"
  }
}
