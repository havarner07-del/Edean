# Edean settings. Copy this file to .env (or edean.env next to the Edean executable).
# Where your model is served (any OpenAI-compatible API).
#   Ollama:     http://127.0.0.1:11434/v1
#   LM Studio:  http://127.0.0.1:1234/v1
#   llama.cpp:  http://127.0.0.1:8080/v1
LLM_BASE_URL=http://127.0.0.1:11434/v1
# Only needed if your backend requires a key.
LLM_API_KEY=
DEFAULT_MODEL=qwen2.5-coder:7b

PORT=3000
# 127.0.0.1 keeps Edean private to this machine. Use 0.0.0.0 to reach it from
# other devices — and change the login password (Settings) first.
HOST=127.0.0.1
# Login password. Leave empty to use the default 0000 and change it in Settings.
APP_PASSWORD=

# Compiler tab: "auto" runs code unless Edean is reachable from the network
# with the default password; "on" always allows it; "off" disables it.
CODE_RUNNER=auto
RUN_TIMEOUT_MS=10000

# Google Drive chat storage (optional). You can also paste these in the app
# under Chat storage. Create a "Desktop app" OAuth client in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Workspace + advisors (optional; you can also enter these in the app).
EDEAN_GITHUB_TOKEN=
ANTHROPIC_API_KEY=
